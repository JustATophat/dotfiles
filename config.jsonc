{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "auto",        // Logo type: auto, builtin, small, file, etc.
    "source": "$HOME/.config/fastfetch/logo.txt",      // Built-in logo name or file path
    "padding": {
        "top": 2,          // Top padding
        "left": 0,         // Left padding
        "right": 0         // Right padding
    },
    "color": {"1": "blue"}
  },
  "display": {
    "separator": " ",
    "constants": [
      "│                                                         │",
    ],
    },
  "modules": [
    "break",
    {
      "type": "custom",
      "key": "╭─ Software ─────────────────────────────────────────╮",
      "keyColor": "blue",
    },
    {
      "type": "os",
      "key": "  󰣇 ",
      "keyColor": "blue",
    },
    {
      "type": "de",
      "key": "  󱂬 ",
      "keyColor": "blue",
    },
    {
      "type": "wm",
      "key": "   ",
      "keyColor": "blue",
    },
    {
      "type": "kernel",
      "key": "   ",
      "keyColor": "blue",
    },
    {
      "type": "packages",
      "key": "  󰏓 ",
      "keyColor": "blue",
    },
    {
      "type": "shell",
      "key": "   ",
      "keyColor": "blue",
    },
    {
      "type": "command",
      "key": "   ",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days",
      "keyColor": "blue",
    },
    {
      "type": "uptime",
      "key": "  󰅐 ",
      "keyColor": "blue",
    },
    {
      "type": "custom",
      "key": "╰────────────────────────────────────────────────────╯",
      "keyColor": "blue",
    },
    {
      "type": "custom",
      "key": "╭─ Hardware ─────────────────────────────────────────╮",
      "keyColor": "blue",
    },
    {
      "type": "display",
      "key": "  󱡶 ",
      "keyColor": "blue",
    },
    {
      "type": "cpu",
      "key": "  󰻠 ",
      "keyColor": "blue",
    },
    {
      "type": "gpu",
      "key": "  󰢮 ",
      "keyColor": "blue",
    },
    {
      "type": "memory",
      "key": "  󰍛 ",
      "keyColor": "blue",
    },
    {
      "type": "swap",
      "key": "  󰓡 ",
      "keyColor": "blue",
    },
    {
      "type": "custom",
      "key": "╰────────────────────────────────────────────────────╯",
      "keyColor": "blue",
    },
    {
      "type": "colors",
      "key": "  ",
      "symbol": "circle"
    },
  ]
}
